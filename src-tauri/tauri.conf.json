{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ogdeveloper",
  "version": "0.2.6",
  "identifier": "com.ogdeveloper.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "ogdeveloper",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 16,
          "y": 18
        },
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' ipc: tauri: http: https: ws: wss:; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' ipc: tauri: http: https: ws: wss:; worker-src 'self' blob:",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "fileAssociations": [
      {
        "ext": [
          "sql"
        ],
        "name": "SQL Script",
        "description": "SQL script",
        "role": "Editor",
        "mimeType": "application/sql"
      },
      {
        "ext": [
          "db",
          "sqlite",
          "sqlite3",
          "duckdb"
        ],
        "name": "Database File",
        "description": "Database file",
        "role": "Editor"
      }
    ],
    "macOS": {
      "entitlements": "Entitlements.plist"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "template": "windows/nsis/installer.nsi"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/opengauss-jdbc-6.0.0.jar",
      "resources/jdbc-plugin.zip"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "ogdeveloper"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkwNkVCNTEyNTYzNEEzQkMKUldTOG96UldFclZ1a095dXRxaVE0RU5jdWZ2aml5WXdYdlRPVkRrSTY4WGQzZHRnMEpoTFI0VmkK",
      "endpoints": [
        "https://github.com/ghost0211/og_developer/releases/latest/download/latest.json"
      ]
    }
  },
  "mainBinaryName": "ogdeveloper"
}